# ==============================================================================
# Docker Prometheus Exporter - Environment Configuration
# ==============================================================================

# Exporter HTTP Listening Port
EXPORTER_PORT=8082

# Auto-Discovery Interval (e.g. 15s, 30s)
# Note: Container lifecycle changes (start, stop, die, destroy) are also 
# captured in real-time via Docker Events API.
DISCOVERY_INTERVAL=15s

# Docker Engine Socket or Proxy Endpoint
# For direct socket: unix:///var/run/docker.sock
# For socket proxy:   tcp://docker-socket-proxy:2375
DOCKER_HOST=unix:///var/run/docker.sock

# Container Image and Version for Docker Compose deployment
IMAGE_NAME=docker-exporter
IMAGE_TAG=1.0.0
